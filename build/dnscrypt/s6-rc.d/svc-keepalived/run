#!/command/with-contenv sh
set -eu
exec 2>&1

: "${KEEPALIVED_VRRP_INSTANCE:?must be set}"
: "${KEEPALIVED_VRRP_ID:?must be set}"
: "${KEEPALIVED_VRRP_PRIORITY:?must be set}"
: "${KEEPALIVED_VIRTUAL_IP:?must be set}"

case "$KEEPALIVED_VRRP_INSTANCE:$KEEPALIVED_VRRP_ID:$KEEPALIVED_VRRP_PRIORITY:$KEEPALIVED_VIRTUAL_IP" in
  *[!A-Za-z0-9_.:/-]*)
    echo 'Invalid keepalived environment value' >&2
    exit 1
    ;;
esac

sed \
  -e "s|__VRRP_INSTANCE__|$KEEPALIVED_VRRP_INSTANCE|g" \
  -e "s|__VRRP_ID__|$KEEPALIVED_VRRP_ID|g" \
  -e "s|__VRRP_PRIORITY__|$KEEPALIVED_VRRP_PRIORITY|g" \
  -e "s|__VIRTUAL_IP__|$KEEPALIVED_VIRTUAL_IP|g" \
  /etc/keepalived/keepalived.conf.template > /run/keepalived.conf

exec /usr/sbin/keepalived --dont-fork --log-console --log-detail --vrrp -f /run/keepalived.conf
